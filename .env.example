# Copiar a .env y completar con datos reales. Nunca commitear .env.
DATABASE_URL=postgres://user:password@localhost:5433/music_platform
MUSICBRAINZ_USER_AGENT=music-platform/0.1 ( contacto@ejemplo.com )

# Origen público de la app (sin barra final). Es la base de los redirects del
# flujo Google OAuth (éxito a /search y página de error localizada); sin esto el
# callback usaría http://localhost:3000 en producción.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo para los smoke tests de scripts/ (ver AGENTS.md): habilita la corrida
# aunque escriban fixtures en la BD de DATABASE_URL. Idealmente apuntar a una
# BD de scratch. Por defecto (sin esta variable) los smoke tests abortan.
# ALLOW_SMOKE_ON_REAL_DB=1

# --- Google OAuth (ADR 0010, auth.md sección 6) ---
# Client ID y Secret de la app OAuth 2.0 registrada en Google Cloud Console.
# Nunca comitear los valores reales; este archivo solo documenta las claves esperadas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir exactamente con el redirect URI configurado en Google Cloud Console
# para este entorno (distinto en local, staging y producción).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Scopes mínimos aprobados: openid email profile — no ampliar sin actualizar auth.md/ADR 0010.
GOOGLE_OAUTH_SCOPES=openid email profile

# --- Email transaccional (ADR 0014, auth.md sección 8) ---
# Transporte de email para el restablecimiento de contraseña.
# `console` (o ausente) usa el adaptador de desarrollo, que SOLO funciona con
# NODE_ENV != production: escribe el correo (con el link del token) por consola.
# En producción, sin un proveedor real configurado, el flujo falla cerrado con
# `EMAIL_CONFIG_MISSING`. Proveedores reales (Resend/SMTP/SES) se agregan
# implementando la interfaz de src/services/email/.
# EMAIL_TRANSPORT=console
# Remitente de los correos transaccionales.
# EMAIL_FROM=music-platform <no-reply@ejemplo.com>


# --- Storage de imágenes propias (openspec: add-image-storage) ---
# Proveedor de storage para imágenes subidas por la aplicación (avatares, etc.).
# `local` escribe en `public/uploads/` (servido estáticamente por Next); solo
# funciona fuera de producción. `s3` usa un proveedor S3-compatible (Cloudflare R2
# u otro); en producción, sin un proveedor real configurado, el servicio falla
# cerrado con `STORAGE_CONFIG_MISSING` (mismo patrón que el transporte de email).
# STORAGE_DRIVER=local
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_PUBLIC_DOMAIN=

# Solo necesario si se activa validación de X-Forwarded-For para rate limiting detrás de un proxy
# confiable (ver auth.md sección 4). No relacionado a Google en sí, pero suele activarse junto
# con el despliegue de OAuth si el entorno usa proxy.
# AUTH_TRUSTED_PROXY=1
# --- Descubrimiento /explore (openspec: add-album-discovery) ---
# 1 = forzar encendido, 0 = forzar apagado. Sin la variable: encendido fuera de
# produccion, apagado en produccion hasta tener contenido semilla suficiente.
# EXPLORE_ENABLED=1
